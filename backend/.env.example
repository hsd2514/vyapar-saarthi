# Pick a Pydantic AI model string matching whichever free-tier key you have.
# Examples:
#   google:gemini-2.0-flash        (needs GEMINI_API_KEY)
#   groq:llama-3.3-70b-versatile   (needs GROQ_API_KEY)
#   openai:gpt-4o-mini             (needs OPENAI_API_KEY)
#   anthropic:claude-haiku-4-5     (needs ANTHROPIC_API_KEY)
#   sarvam:sarvam-105b             (needs SARVAM_API_KEY - resolved via agent.py's
#                                    OpenAI-compatible client, see docs.sarvam.ai)
AGENT_MODEL=google:gemini-2.0-flash

# Set whichever key matches the provider in AGENT_MODEL above.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# Only needed if Sarvam changes their API base URL - defaults to
# https://api.sarvam.ai/v1 (their OpenAI-compatible endpoint) in agent.py.
SARVAM_BASE_URL=

# --- Twilio phone-call (IVR) access to the voice intake agent ---
# Auth token from the Twilio console - used to verify that /api/twilio/*
# webhooks genuinely came from Twilio (X-Twilio-Signature check in
# twilio_ivr.py). Leave empty for local dev before you've set this up;
# NEVER leave it empty on a publicly reachable deployment.
TWILIO_AUTH_TOKEN=

# BCP-47 locale Twilio's speech-to-text listens for on <Gather>. Twilio
# supports hi-IN and en-IN for this app's languages; mr-IN is not in
# Twilio's supported speech-recognition locale list, so Marathi callers
# are recognised under hi-IN (the LLM still extracts meaning correctly,
# same as it already handles code-mixed speech on the web app).
TWILIO_GATHER_LANGUAGE=hi-IN

# BCP-47 locale used for Twilio's <Say> voice reading replies back.
TWILIO_SAY_LANGUAGE=hi-IN
