# =============================================================================
# Vyapar Saarthi backend - environment config template.
# Copy this to .env and fill in your own keys - .env is gitignored, this
# file is the committed template.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider - pick ONE line for AGENT_MODEL and set the matching key below.
# All three languages this app speaks (Hindi, English, Marathi) are handled
# by the SAME model via prompting (see agent.py's INTAKE_SYSTEM_PROMPT) - you
# do not need a different key per language, any of these models understands
# code-mixed Hindi/English/Marathi input and replies in kind.
# -----------------------------------------------------------------------------
#   google:gemini-2.0-flash                        (needs GEMINI_API_KEY - free tier: aistudio.google.com)
#   groq:llama-3.3-70b-versatile                    (needs GROQ_API_KEY - free tier: console.groq.com)
#   openai:gpt-4o-mini                              (needs OPENAI_API_KEY)
#   anthropic:claude-haiku-4-5                      (needs ANTHROPIC_API_KEY)
#   sarvam:sarvam-105b                              (needs SARVAM_API_KEY - built for Indian languages, docs.sarvam.ai)
#   opencode:muse-spark-1.3-contributor-free        (needs OPENCODE_API_KEY - free tier, opencode.ai/docs/zen -
#                                                     NOTE: their free tier only works inside OpenCode's own CLI,
#                                                     it rejects calls from external apps like this one)
#   fastrouter:z-ai/glm-5.3-flash                   (needs FASTROUTER_API_KEY - fastrouter.ai, OpenAI-compatible)
AGENT_MODEL=google:gemini-2.0-flash

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
OPENCODE_API_KEY=
FASTROUTER_API_KEY=

# Only needed if Sarvam changes their API base URL - defaults to
# https://api.sarvam.ai/v1 (their OpenAI-compatible endpoint) in agent.py.
SARVAM_BASE_URL=

# Only needed if OpenCode Zen changes their API base URL - defaults to
# https://opencode.ai/zen/v1 (their OpenAI Responses-API-compatible
# endpoint) in agent.py.
OPENCODE_BASE_URL=

# Only needed if FastRouter changes their API base URL - defaults to
# https://api.fastrouter.ai/api/v1 in agent.py.
FASTROUTER_BASE_URL=

# -----------------------------------------------------------------------------
# Twilio phone-call (IVR) access to the voice intake agent - see
# backend/twilio_ivr.py. Get these from the Twilio console.
# -----------------------------------------------------------------------------

# Account SID and phone number are read by twilio_ivr.py's outbound
# "call me" endpoint (POST /api/twilio/call-me), and are also what you'd
# use when configuring the number's inbound webhook in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# Public URL Twilio should fetch TwiML from once an OUTBOUND call (the
# "call me" button) is answered - Twilio can't reach localhost, so this
# must be your current tunnel URL (e.g. ngrok) or real deployed URL.
TWILIO_PUBLIC_BASE_URL=

# The FRONTEND app's own origin (not the backend's) - used to build the
# shareable report link auto-created the moment a phone call finishes, so
# the caller's feasibility report + loan details are a browser link away
# instead of read back over voice. Defaults to the local Vite dev server.
TWILIO_FRONTEND_ORIGIN=http://localhost:5173

# Auth token IS read by the backend (twilio_ivr.py) to verify every
# /api/twilio/* webhook really came from Twilio via the X-Twilio-Signature
# header. Leave empty only for local testing before you've set this up -
# never leave it empty on a publicly reachable deployment.
TWILIO_AUTH_TOKEN=

# BCP-47 locale Twilio's speech-to-text listens for on each call.
# Twilio supports hi-IN and en-IN for this app's languages. mr-IN is not in
# Twilio's supported speech-recognition locale list, so a Marathi caller is
# recognised under hi-IN - the LLM still extracts meaning correctly, the same
# way it already handles code-mixed Hindi/Marathi/English speech on the web
# app's voice agent. Switch to en-IN here if most callers will speak English.
TWILIO_GATHER_LANGUAGE=hi-IN

# BCP-47 locale for Twilio's <Say> voice reading replies back to the caller.
TWILIO_SAY_LANGUAGE=hi-IN
