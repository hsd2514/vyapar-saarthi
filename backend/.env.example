# Pick a Pydantic AI model string matching whichever free-tier key you have.
# Examples:
#   google:gemini-2.0-flash        (needs GEMINI_API_KEY)
#   groq:llama-3.3-70b-versatile   (needs GROQ_API_KEY)
#   openai:gpt-4o-mini             (needs OPENAI_API_KEY)
#   anthropic:claude-haiku-4-5     (needs ANTHROPIC_API_KEY)
#   sarvam:sarvam-105b             (needs SARVAM_API_KEY - resolved via agent.py's
#                                    OpenAI-compatible client, see docs.sarvam.ai)
AGENT_MODEL=google:gemini-2.0-flash

# Set whichever key matches the provider in AGENT_MODEL above.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# Only needed if Sarvam changes their API base URL - defaults to
# https://api.sarvam.ai/v1 (their OpenAI-compatible endpoint) in agent.py.
SARVAM_BASE_URL=
